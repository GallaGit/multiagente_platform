# Groq API key — https://console.groq.com/keys
# (same key as GROQ_API_KEY in Groq playground examples)
LLM_API_KEY=

# MVP: only groq is supported
LLM_PROVIDER=groq

# Groq chat model (playground default)
LLM_MODEL=llama-3.3-70b-versatile

# Pack de nicho en docs/nichos/<id>/ (manifest.json + runtime)
ACTIVE_NICHE=inmobiliaria
