# Groq API key — https://console.groq.com/keys
# (same key as GROQ_API_KEY in Groq playground examples)
LLM_API_KEY=

# MVP: only groq is supported
LLM_PROVIDER=groq

# Groq chat model
LLM_MODEL=openai/gpt-oss-120b

# Pack de nicho en docs/nichos/<id>/ (manifest.json + runtime)
ACTIVE_NICHE=inmobiliaria

# HubSpot Private App — https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
# Set false only on local Windows if SSL interception breaks HubSpot calls
HUBSPOT_VERIFY_SSL=true

# Lead orchestration
SLA_MINUTES=60
# Comma-separated HubSpot owner IDs; leave empty to fetch all owners
ROUND_ROBIN_OWNER_IDS=

# Frontend dev server origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
